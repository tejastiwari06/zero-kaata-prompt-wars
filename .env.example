# ==============================================================================
# BEYOND THE GRID — ENVIRONMENT CONFIGURATION
# ==============================================================================
# "Every Move Changes Everything."
# 
# Beyond the Grid operates seamlessly offline in Local Mode using LocalStorage
# and BroadcastChannel for cross-tab multi-window play with ZERO configuration!
# 
# To enable cloud persistence, cross-device online matchmaking, and real-time
# multiplayer rooms via Supabase or Firebase, supply the keys below:
# ==============================================================================

# Application Environment
VITE_APP_ENV=development
VITE_APP_TITLE="Beyond the Grid"
VITE_APP_URL="http://localhost:3000"

# ------------------------------------------------------------------------------
# OPTION A: SUPABASE BACKEND (Recommended for Postgres + Realtime channels)
# ------------------------------------------------------------------------------
# 1. Create a free project at https://supabase.com
# 2. In Project Settings -> API, copy Project URL and anon public key
# 3. Execute the schema script provided in docs/supabase_schema.sql
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ------------------------------------------------------------------------------
# OPTION B: FIREBASE BACKEND (Alternative for Firestore + Realtime DB)
# ------------------------------------------------------------------------------
# 1. Create a project at https://console.firebase.google.com
# 2. Register a Web App and copy the config parameters below:
VITE_FIREBASE_API_KEY=AIzaSy...
VITE_FIREBASE_AUTH_DOMAIN=beyond-the-grid.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=beyond-the-grid
VITE_FIREBASE_STORAGE_BUCKET=beyond-the-grid.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=1234567890
VITE_FIREBASE_APP_ID=1:1234567890:web:abcdef

# ------------------------------------------------------------------------------
# MULTIPLAYER FEATURE TOGGLES
# ------------------------------------------------------------------------------
# Set to 'true' to prefer remote cloud rooms, or 'false' for peer-to-peer / local
VITE_ENABLE_REMOTE_MULTIPLAYER=false
VITE_ROOM_DISCONNECT_TIMEOUT_SEC=45
VITE_TURN_TIME_LIMIT_DEFAULT_SEC=15
